# === Required for OAuth mode ===

# Public HTTPS host where this server is reachable (e.g. https://mcp.example.com).
# Used as RFC 8707 resource indicator and as `issuer` in AS metadata.
SLACK_MCP_OAUTH_ISSUER=https://mcp.example.com

# Public domain Caddy will obtain a TLS cert for. Strip the https:// prefix.
SLACK_MCP_DOMAIN=mcp.example.com

# Slack OAuth app credentials. Create at https://api.slack.com/apps.
# Configure the OAuth redirect URL in the Slack app to ${ISSUER}/oauth/slack/callback.
SLACK_MCP_OAUTH_CLIENT_ID=
SLACK_MCP_OAUTH_CLIENT_SECRET=
SLACK_MCP_OAUTH_REDIRECT_URI=https://mcp.example.com/oauth/slack/callback

# 32-byte AES-GCM key, base64url-encoded (no padding). Generate with:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# Refusing to start in OAuth mode without this.
SLACK_MCP_OAUTH_MASTER_KEY=

# === Optional ===

# Slack OAuth scopes to request. Defaults are sane.
# Comma-separated. See https://api.slack.com/scopes.
# SLACK_MCP_OAUTH_USER_SCOPES=channels:history,users:read,search:read,im:history,...
# SLACK_MCP_OAUTH_BOT_SCOPES=chat:write,...

# Comma-separated list of MCP tools to enable. Defaults to all read-only tools.
# SLACK_MCP_ENABLED_TOOLS=

# Expose /metrics under expvar. Unauthenticated; firewall it.
# SLACK_MCP_OAUTH_METRICS=true

# Log level: debug | info | warn | error
SLACK_MCP_LOG_LEVEL=info
